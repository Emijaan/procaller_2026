SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (preferred). Leave unset to use local SQLite for first boot.
# Encode @ in passwords as %40
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/procaller

# sandbox | asterisk
TELEPHONY_BACKEND=sandbox

ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=procaller
ASTERISK_ARI_PASSWORD=changeme
ASTERISK_ARI_APP=procaller
ASTERISK_SIP_WS=wss://127.0.0.1:8089/ws
ASTERISK_SIP_DOMAIN=127.0.0.1
ASTERISK_TRUNK=gsm222
ASTERISK_DIAL_PREFIX=
ASTERISK_STRIP_COUNTRY_CODE=91
